{
  "name": "@vukasync/supabase",
  "private": true,
  "version": "0.0.0",
  "description": "Shared Supabase client utilities for VukaSync OS.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"No tests configured for @vukasync/supabase yet.\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@vukasync/config": "workspace:*"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1"
  }
}
