# VukaSync OS local development environment template.
# Use values from vukasync-dev only during Phase 3B.

# Web client-safe Supabase values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mobile client-safe Supabase values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase value.
# Never expose this in browser or mobile bundles.
SUPABASE_SERVICE_ROLE_KEY=
