# VukaSync OS web environment template.
# Use values from vukasync-dev only during Phase 3B.

# Client-safe Supabase values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase value.
# Do not expose this value through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
